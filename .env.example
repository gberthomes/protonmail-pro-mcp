# ---- Public address (DNS must point to this host; Caddy obtains the certificate)
MCP_DOMAIN=mail-mcp.example.com

# ---- Mail accounts (Proton through Bridge, Gmail, Outlook, any IMAP server)
# Easiest: add them in the web interface at https://$MCP_DOMAIN/admin after signing in.
# Or declare them here (Bridge > account > Mailbox configuration):
# PROTONMAIL_USERNAME=me@proton.me
# PROTONMAIL_PASSWORD=bridge-generated-password
# More accounts (any index or name):
# PROTONMAIL_ACCOUNT_WORK_EMAIL=work@pm.me
# PROTONMAIL_ACCOUNT_WORK_PASSWORD=another-bridge-password
# PROTONMAIL_ACCOUNT_WORK_USERS=alice@corp.example,group:mail-admins

# ---- Sign-in with your OpenID Connect provider
# Register a confidential "web" client whose redirect URI is https://$MCP_DOMAIN/oauth/callback
OIDC_ISSUER=https://auth.example.com/realms/home
OIDC_CLIENT_ID=protonmail-mcp
OIDC_CLIENT_SECRET=change-me
# Who may sign in and add their own mailboxes (emails, *@domain, group:<name>, sub:<id>).
MCP_ALLOWED_USERS=me@example.com
# Who administers every mailbox in the web interface (defaults to MCP_ALLOWED_USERS).
# MCP_ADMIN_USERS=me@example.com

# ---- Optional: "Sign in with Google / Microsoft" for Gmail and Outlook mailboxes
# Redirect URI to register: https://$MCP_DOMAIN/admin/oauth/mail/callback
# MAIL_OAUTH_GOOGLE_CLIENT_ID=
# MAIL_OAUTH_GOOGLE_CLIENT_SECRET=
# MAIL_OAUTH_MICROSOFT_CLIENT_ID=
# MAIL_OAUTH_MICROSOFT_CLIENT_SECRET=
# MAIL_OAUTH_MICROSOFT_TENANT=common

# ---- Optional
# OIDC_SCOPES=openid email profile groups
# OIDC_GROUPS_CLAIM=groups
# MCP_API_KEYS=long-random-key-for-scripts=robot@example.com
# LOG_LEVEL=info
