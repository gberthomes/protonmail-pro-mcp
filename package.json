{
  "name": "protonmail-pro-mcp",
  "version": "2.0.0",
  "description": "Proton Mail MCP server (via Proton Mail Bridge): stdio and Streamable HTTP/HTTPS (MCP 2026-07-28 + 2025 clients), built-in OIDC authorization, multi-account.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "protonmail-pro-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "protonmail",
    "proton",
    "mcp",
    "model-context-protocol",
    "email",
    "imap",
    "smtp",
    "bridge",
    "oidc",
    "oauth"
  ],
  "author": "gberthomes",
  "license": "MIT",
  "homepage": "https://github.com/gberthomes/protonmail-pro-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gberthomes/protonmail-pro-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gberthomes/protonmail-pro-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/server-legacy": "^2.4.0",
    "express": "^5.3.0",
    "imapflow": "^1.7.8",
    "jose": "^6.2.15",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "hoodiecrow-imap": "^2.1.0",
    "smtp-server": "^3.21.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "protonmail-mcp.example.json"
  ]
}
